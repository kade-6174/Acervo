{
	email {$CADDY_EMAIL}
	admin off
}

(acervo_routes) {
	encode zstd gzip

	@django_admin path /admin /admin/ /admin/*
	respond @django_admin 404

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}

{$ACERVO_DOMAIN} {
	import acervo_routes
}

:8080 {
	encode zstd gzip

	@django_admin path /admin /admin/ /admin/*
	respond @django_admin 404

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto https
		}
	}
}
