{
	email {$CADDY_EMAIL}
	admin off

	servers :8080 {
		trusted_proxies static private_ranges
		trusted_proxies_strict
		client_ip_headers CF-Connecting-IP
	}
}

(acervo_common) {
	encode zstd gzip

	handle /admin* {
		respond 404
	}

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

}

{$ACERVO_DOMAIN} {
	import acervo_common

	handle {
		reverse_proxy web:8000 {
			header_up X-Acervo-Client-IP {client_ip}
		}
	}
}

:8080 {
	import acervo_common

	handle {
		reverse_proxy web:8000 {
			header_up X-Forwarded-Proto https
			header_up X-Acervo-Client-IP {client_ip}
		}
	}
}
