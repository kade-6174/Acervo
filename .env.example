DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-this-in-your-local-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
ACERVO_SITE_NAME=Acervo Development
ACERVO_ORGANIZATION_NAME=
ACERVO_ENROLLMENT_POLICY=none
# school_cohortを選ぶ場合だけ、導入先の学校年度・回生基準を設定する。
ACERVO_SCHOOL_YEAR_START_MONTH=4
ACERVO_SCHOOL_YEAR_START_DAY=1
ACERVO_BASE_SCHOOL_YEAR=2026
ACERVO_BASE_THIRD_YEAR_COHORT=31

POSTGRES_DB=acervo
POSTGRES_USER=acervo
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
