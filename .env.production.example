DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-at-least-64-random-characters-generated-for-this-instance
DJANGO_ALLOWED_HOSTS=acervo.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://acervo.example.org
DJANGO_TIME_ZONE=Asia/Tokyo
ACERVO_PUBLIC_BASE_URL=https://acervo.example.org
ACERVO_SITE_NAME=Acervo
ACERVO_ORGANIZATION_NAME=Example Organization
ACERVO_ENROLLMENT_POLICY=none
# school_cohortを選ぶ場合だけ、導入先の学校年度と基準年度の1年生回生を設定する。
ACERVO_SCHOOL_YEAR_START_MONTH=4
ACERVO_SCHOOL_YEAR_START_DAY=1
ACERVO_BASE_SCHOOL_YEAR=2026
ACERVO_BASE_FIRST_YEAR_COHORT=33
ACERVO_MFA_FERNET_KEYS=replace-with-comma-separated-fernet-keys-generated-for-this-instance

POSTGRES_DB=acervo
POSTGRES_USER=acervo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

ACERVO_DOMAIN=acervo.example.org
CADDY_EMAIL=admin@example.org
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=30
